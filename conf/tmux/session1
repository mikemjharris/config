#session
# Layout:
#   left column (40%): vim (top) + lazygit (bottom)
#   right column (60%): two panes split 50/50
attach -c "#{pane_current_path}"

send-keys "vim ." C-m

splitw -h -p 60
splitw -v -p 50

splitw -v -p 50 -t '{top-left}'
send-keys -t '{bottom-left}' "lazygit" C-m

select-pane -t '{top-left}'
